# ---------------------------------------------------------------------------
# FlowOrchestrator environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Clerk (authentication + organizations) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (PostgreSQL + realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
# Server-only. Bypasses RLS — used by trusted API routes / webhook handlers only.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# --- Stripe (global cards, live in MVP week 1 as sandbox) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Checkout.com (MENA, week 3-4) ---
CHECKOUT_SECRET_KEY=sk_sbox_xxx
CHECKOUT_WEBHOOK_SECRET=xxx

# --- Fawri+ (Qatar local transfers, week 3-4) ---
FAWRI_API_KEY=xxx
FAWRI_API_BASE=https://sandbox.fawri.example
FAWRI_WEBHOOK_SECRET=xxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated ISO currencies the platform is licensed to process.
SUPPORTED_CURRENCIES=QAR,AED,USD
